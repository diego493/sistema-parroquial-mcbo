generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definición de los roles de acceso al sistema
enum RolSistema {
  SUPREMO
  ADMINISTRADOR
  COORDINADOR_PARROQUIAL
}

// Los 5 cargos específicos que definiste para el cuadro
enum CargoEstructura {
  COORDINADOR_PARROQUIAL
  COORDINADOR_ORGANIZACION
  COORDINADOR_COMUNICACIONES
  SECRETARIO_POLITICO_1
  SECRETARIO_POLITICO_2
  AFILIADO
  DIRECTIVA_MUNICIPAL
}

model Persona {
  id               String   @id @default(cuid())
  cedula           String   @unique
  nombres          String
  apellidos        String
  telefono         String
  parroquia        String   // Una de las 18 de Maracaibo
  cargo            CargoEstructura
  
  // Tu Checklist del CNE
  estaInscritoCNE  Boolean  @default(false)
  centroVotacion   String?  // Solo se llena si el checklist es SI
  
  registradoPor    String   // Quién hizo el ingreso
  createdAt        DateTime @default(now())
}
